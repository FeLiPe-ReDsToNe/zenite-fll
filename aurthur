def girar(graus, velocidade_maxima):
    global target_heading
    atualizar_target_heading(graus)

    angulo_inicial = hub.imu.heading()
    erro_anterior = (target_heading - angulo_inicial + 180) % 360 - 180

    cronometro = StopWatch()

    while True:
        verificar_voltar_menu()

        angulo_atual = hub.imu.heading()
        erro = (target_heading - angulo_atual + 180) % 360 - 180

        # Tolerância ligeiramente maior para concluir mais rápido
        if abs(erro) < 1.0 and abs(motor_esq.speed()) < 20:
            break

        tempo = cronometro.time()
        cronometro.reset()

        dt = max(0.01, min(0.1, tempo / 1000))

        derivada = ((erro - erro_anterior + 180) % 360 - 180) / dt
        erro_anterior = erro

        sinal_controle = (erro * KP_TURN) + (derivada * KD_TURN)

        # Limite máximo de velocidade
        sinal_controle = max(
            -velocidade_maxima,
            min(velocidade_maxima, sinal_controle)
        )

        # Velocidade mínima longe do alvo
        if abs(sinal_controle) < 22 and abs(erro) >= 2.0:
            sinal_controle = 22 if erro > 0 else -22

        motor_esq.run(-sinal_controle)
        motor_dir.run(sinal_controle)

        wait(10)

    # Frenagem em vez de deixar os motores livres
    motor_esq.brake()
    motor_dir.brake()

    print('Rotação concluída em {}°'.format(hub.imu.heading()))
