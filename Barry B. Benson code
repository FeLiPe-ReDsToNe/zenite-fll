# BASE ZENTIE FLL / PYBRICKS
#
# Deslocamentos: graus medios dos encoders dos motores A e B.
# Giros: graus da IMU do hub, sempre referidos a orientacao inicial da rotina.

from pybricks.hubs import PrimeHub
from pybricks.pupdevices import Motor
from pybricks.parameters import Button, Direction, Port, Stop
from pybricks.tools import StopWatch, wait


# CONFIGURACAO ORIGINAL DO ROBO ZENTIE
hub = PrimeHub()
motor_esq = Motor(Port.A, Direction.COUNTERCLOCKWISE)
motor_dir = Motor(Port.B, Direction.CLOCKWISE)
motor_aux_esq = Motor(Port.C)
motor_aux_dir = Motor(Port.D)

LIMITE_MOTOR = 1000       # graus/s: protege contra valores acima do motor.
ACELERACAO_MOTOR = 4000   # graus/s^2: limite interno dos motores.
motor_esq.control.limits(speed=LIMITE_MOTOR, acceleration=ACELERACAO_MOTOR)
motor_dir.control.limits(speed=LIMITE_MOTOR, acceleration=ACELERACAO_MOTOR)

relogio_global = StopWatch()

# Referencia global de orientacao. girar(90) sempre aponta para 90 graus.
angulo_alvo = 0.0

# Ganhos da estabilizacao de direcao durante mover().
KP_LINE = 4.5
KI_LINE = 0.01
KD_LINE = 1.2

# tipo, alvo, realizado, erro, angulo_alvo, angulo_final, erro_angulo, tempo_ms
log_movimentos = []


class VoltarMenu(Exception):
    pass


def esperar_soltar_botoes():
    while hub.buttons.pressed():
        wait(10)


def parar_todos_motores():
    motor_esq.brake()
    motor_dir.brake()
    motor_aux_esq.brake()
    motor_aux_dir.brake()


def verificar_voltar_menu():
    """CENTRO interrompe uma rotina, inclusive dentro dos controladores."""
    if Button.CENTER in hub.buttons.pressed():
        parar_todos_motores()
        esperar_soltar_botoes()
        raise VoltarMenu()


def limitar(valor, limite):
    return max(-limite, min(valor, limite))


def erro_angular(alvo, atual):
    """Menor erro entre dois angulos; preserva angulo_alvo como valor global."""
    return (alvo - atual + 180) % 360 - 180


def rampa(atual, desejada, aceleracao, desaceleracao, dt):
    """Limita a mudanca de velocidade para reduzir derrapagem e inercia."""
    taxa = desaceleracao if abs(desejada) < abs(atual) or atual * desejada < 0 else aceleracao
    return atual + limitar(desejada - atual, taxa * dt)


def pid(erro, erro_anterior, integral, derivada, dt, kp, ki, kd, limite,
        erro_eh_angular=False):
    """PID com derivada filtrada e integral limitada contra saturacao."""
    # Em giros, -179 para +179 representa apenas 2 graus, nao 358 graus.
    if erro_eh_angular:
        delta_erro = erro_angular(erro, erro_anterior)
    else:
        delta_erro = erro - erro_anterior
    derivada_bruta = delta_erro / dt
    derivada += dt / (0.04 + dt) * (derivada_bruta - derivada)
    tentativa_integral = integral
    if ki != 0 and abs(erro) < 12:
        tentativa_integral = limitar(integral + erro * dt, 30)
    saida_sem_i = kp * erro + kd * derivada
    saida = saida_sem_i + ki * tentativa_integral
    if abs(saida) <= limite:
        integral = tentativa_integral
    return limitar(saida_sem_i + ki * integral, limite), integral, derivada


def comandar_rodas(velocidade, correcao):
    """Velocidades em graus/s; correcao positiva acelera a roda esquerda."""
    motor_esq.run(limitar(velocidade + correcao, LIMITE_MOTOR))
    motor_dir.run(limitar(velocidade - correcao, LIMITE_MOTOR))


def registrar_movimento(tipo, alvo, realizado, erro, alvo_angulo,
                         angulo_final, erro_angulo, inicio):
    log_movimentos.append((tipo, alvo, realizado, erro, alvo_angulo,
                           angulo_final, erro_angulo,
                           relogio_global.time() - inicio))


def mostrar_log():
    print("tipo,alvo,realizado,erro,angulo_alvo,angulo_final,erro_angulo,tempo_ms")
    for linha in log_movimentos:
        print(*linha, sep=",")


def limpar_log():
    log_movimentos.clear()


def conferir_seguranca(inicio, tempo_limite, verificar_esq=True,
                       verificar_dir=True):
    verificar_voltar_menu()
    if relogio_global.time() - inicio >= tempo_limite:
        parar_todos_motores()
        raise RuntimeError("O movimento demorou demais")
    if verificar_esq and motor_esq.stalled():
        parar_todos_motores()
        raise RuntimeError("A roda esquerda travou")
    if verificar_dir and motor_dir.stalled():
        parar_todos_motores()
        raise RuntimeError("A roda direita travou")


def atualizar_angulo_alvo(novo_angulo):
    global angulo_alvo
    angulo_alvo = float(novo_angulo)


def inicial(parado_ms=500, tempo_limite=5000):
    """Cria a referencia global 0 graus somente quando a IMU estiver estavel."""
    global angulo_alvo
    parar_todos_motores()
    inicio = relogio_global.time()
    parado_desde = inicio
    while True:
        verificar_voltar_menu()
        agora = relogio_global.time()
        if agora - inicio >= tempo_limite:
            raise RuntimeError("Deixe o robo parado para zerar a IMU")
        if not hub.imu.ready() or not hub.imu.stationary():
            parado_desde = agora
        elif agora - parado_desde >= parado_ms:
            break
        wait(10)
    hub.imu.reset_heading(0)
    angulo_alvo = 0.0


def mover(distancia_graus, velocidade_base, usar_sensores_parada=False,
          aceleracao=1800, desaceleracao=2400, periodo_ms=5,
          tempo_limite=8000):
    """Perfil por zonas + PID de direcao, usando graus de motor.

    A distancia e medida pela media dos dois encoders. Isso conserva o perfil
    de aceleracao/desaceleracao enviado e detecta diferencas entre as rodas.
    """
    if min(abs(velocidade_base), aceleracao, desaceleracao, periodo_ms,
           tempo_limite) <= 0:
        raise ValueError("Velocidades, aceleracao e tempos devem ser positivos")
    if usar_sensores_parada:
        raise RuntimeError("Sensores de parada ainda nao foram configurados")

    # Corrige o caso negativo da versao enviada: zero nao deve virar re.
    distancia_alvo = abs(distancia_graus)
    velocidade_base = min(abs(velocidade_base), LIMITE_MOTOR)
    if distancia_graus < 0:
        velocidade_base = -velocidade_base

    motor_esq.reset_angle(0)
    motor_dir.reset_angle(0)
    inicio = anterior = relogio_global.time()
    angulo_atual = hub.imu.heading()
    if distancia_alvo == 0:
        motor_esq.hold()
        motor_dir.hold()
        registrar_movimento("mover", 0, 0, 0, angulo_alvo, angulo_atual,
                            erro_angular(angulo_alvo, angulo_atual), inicio)
        return 0

    erro_anterior = 0.0
    integral = 0.0
    zona_aceleracao = distancia_alvo * 0.20
    zona_deceleracao = distancia_alvo * 0.75
    velocidade_inicial = velocidade_base * 0.50
    velocidade_final = velocidade_base * 0.60
    velocidade_atual = 0.0

    while True:
        agora = relogio_global.time()
        dt = max(1, agora - anterior) / 1000
        anterior = agora
        conferir_seguranca(inicio, tempo_limite)
        realizado = (motor_esq.angle() + motor_dir.angle()) / 2
        graus_atuais = abs(realizado)
        if graus_atuais >= distancia_alvo:
            break

        # 1. Aceleracao: 50% ate 100% nos primeiros 20% da distancia.
        if graus_atuais < zona_aceleracao:
            proporcao = graus_atuais / zona_aceleracao
            vel_alvo = velocidade_inicial + (velocidade_base - velocidade_inicial) * proporcao
        # 2. Desaceleracao: 100% ate 60% nos ultimos 25% da distancia.
        elif graus_atuais > zona_deceleracao:
            proporcao_decel = 1.0 - ((graus_atuais - zona_deceleracao) /
                                     (distancia_alvo - zona_deceleracao))
            proporcao_decel = max(0.0, min(1.0, proporcao_decel))
            vel_alvo = velocidade_final + (velocidade_base - velocidade_final) * proporcao_decel
        else:
            vel_alvo = velocidade_base

        # A rampa temporal evita salto de velocidade mesmo ao cruzar zonas.
        velocidade_atual = rampa(velocidade_atual, vel_alvo, aceleracao,
                                 desaceleracao, dt)
        angulo_atual = hub.imu.heading()
        erro = erro_angular(angulo_alvo, angulo_atual)
        integral = limitar(integral + erro, 200)
        if abs(erro) > 8:
            integral = 0
        derivada = erro - erro_anterior
        erro_anterior = erro
        correcao = KP_LINE * erro + KI_LINE * integral + KD_LINE * derivada
        comandar_rodas(velocidade_atual, correcao)
        wait(max(1, periodo_ms - (relogio_global.time() - agora)))

    motor_esq.hold()
    motor_dir.hold()
    wait(10)
    realizado = (motor_esq.angle() + motor_dir.angle()) / 2
    angulo_atual = hub.imu.heading()
    erro = erro_angular(angulo_alvo, angulo_atual)
    registrar_movimento("mover", distancia_graus, realizado,
                        distancia_graus - realizado, angulo_alvo,
                        angulo_atual, erro, inicio)
    return realizado


def girar(angulo, velocidade=420, kp=9.0, kd=0.25, aceleracao=1400,
          desaceleracao=2000, tolerancia=0.7, estabilidade_ms=80,
          periodo_ms=10, tempo_limite=9000):
    """Giro central PD, guiado exclusivamente pela IMU do hub."""
    atualizar_angulo_alvo(angulo)
    return _girar_imu("girar", velocidade, kp, kd, aceleracao,
                       desaceleracao, tolerancia, estabilidade_ms,
                       periodo_ms, tempo_limite, None)


def girar_pivo(angulo, pivo="esquerda", velocidade=350, kp=9.0, kd=0.25,
               aceleracao=1200, desaceleracao=1800, tolerancia=0.8,
               estabilidade_ms=80, periodo_ms=10, tempo_limite=9000):
    """Gira mantendo uma roda parada: ``pivo='esquerda'`` ou ``'direita'``.

    Use-o quando a roda parada estiver bem apoiada e puder servir de ponto de
    referencia. Ele ocupa mais area que o giro central e pode escorregar se o
    ponto de pivo estiver sobre uma borda ou tapete irregular.
    """
    if pivo not in ("esquerda", "direita"):
        raise ValueError("pivo deve ser 'esquerda' ou 'direita'")
    atualizar_angulo_alvo(angulo)
    return _girar_imu("pivo_" + pivo, velocidade, kp, kd, aceleracao,
                       desaceleracao, tolerancia, estabilidade_ms,
                       periodo_ms, tempo_limite, pivo)


def _girar_imu(tipo, velocidade, kp, kd, aceleracao, desaceleracao,
                tolerancia, estabilidade_ms, periodo_ms, tempo_limite, pivo):
    if min(abs(velocidade), aceleracao, desaceleracao, tolerancia,
           estabilidade_ms, periodo_ms, tempo_limite) <= 0:
        raise ValueError("Velocidades, tolerancias e tempos devem ser positivos")
    velocidade = min(abs(velocidade), LIMITE_MOTOR)

    erro_anterior = erro_angular(angulo_alvo, hub.imu.heading())
    derivada = velocidade_atual = 0
    inicio = anterior = relogio_global.time()
    parado_desde = None

    while True:
        agora = relogio_global.time()
        dt = max(1, agora - anterior) / 1000
        anterior = agora
        # A roda de pivo fica em hold; portanto, nao a interprete como travada.
        conferir_seguranca(inicio, tempo_limite, pivo != "esquerda",
                           pivo != "direita")
        angulo_atual = hub.imu.heading()
        erro = erro_angular(angulo_alvo, angulo_atual)
        # O PD ja reduz a velocidade quando o erro diminui. Nao usamos
        # sqrt(2*a*erro): ``a`` e graus de motor/s² e ``erro`` e graus da IMU.
        # Misturar essas unidades tornava a frenagem inconsistente.
        desejada, _, derivada = pid(
            erro, erro_anterior, 0, derivada, dt, kp, 0, kd,
            abs(velocidade), erro_eh_angular=True)
        erro_anterior = erro
        velocidade_atual = rampa(velocidade_atual, desejada, aceleracao,
                                 desaceleracao, dt)

        if abs(erro) <= tolerancia:
            # Se houver uma pequena deriva depois, a proxima correcao comeca
            # do repouso, sem reaplicar a velocidade alta do ciclo anterior.
            velocidade_atual = 0
            if pivo is None:
                comandar_rodas(0, 0)
            elif pivo == "esquerda":
                motor_esq.hold()
                motor_dir.run(0)
            else:
                motor_esq.run(0)
                motor_dir.hold()
            if parado_desde is None:
                parado_desde = agora
            if agora - parado_desde >= estabilidade_ms:
                motor_esq.hold()
                motor_dir.hold()
                registrar_movimento(tipo, angulo_alvo, angulo_atual, erro,
                                    angulo_alvo, angulo_atual, erro, inicio)
                return angulo_atual
        else:
            parado_desde = None
            if pivo is None:
                comandar_rodas(0, velocidade_atual)
            elif pivo == "esquerda":
                motor_esq.hold()
                motor_dir.run(limitar(-velocidade_atual, LIMITE_MOTOR))
            else:
                motor_esq.run(limitar(velocidade_atual, LIMITE_MOTOR))
                motor_dir.hold()
        wait(max(1, periodo_ms - (relogio_global.time() - agora)))


def run_angle_interrompivel(motor, velocidade, angulo, tempo_limite=5000):
    inicio = relogio_global.time()
    motor.run_angle(abs(velocidade), angulo, then=Stop.HOLD, wait=False)
    while not motor.done():
        verificar_voltar_menu()
        if relogio_global.time() - inicio >= tempo_limite:
            parar_todos_motores()
            raise RuntimeError("Uma ferramenta demorou demais")
        if motor.stalled():
            parar_todos_motores()
            raise RuntimeError("Uma ferramenta travou")
        wait(10)


def run_until_stalled_interrompivel(motor, velocidade, tempo_limite=4000):
    inicio = relogio_global.time()
    motor.run(velocidade)
    while not motor.stalled():
        verificar_voltar_menu()
        if relogio_global.time() - inicio >= tempo_limite:
            motor.stop()
            raise RuntimeError("A ferramenta nao encontrou o fim de curso")
        wait(10)
    motor.stop()


def auxD(posicao, velocidade=-400):
    if posicao == "inicio":
        run_until_stalled_interrompivel(motor_aux_esq, velocidade)
        wait(100)
    else:
        run_angle_interrompivel(motor_aux_esq, velocidade, int(posicao))


def auxE(posicao, velocidade=-400):
    if posicao == "inicio":
        run_until_stalled_interrompivel(motor_aux_dir, velocidade)
        wait(100)
    else:
        run_angle_interrompivel(motor_aux_dir, velocidade, int(posicao))


def esperar(tempo_ms):
    inicio = relogio_global.time()
    while relogio_global.time() - inicio < tempo_ms:
        verificar_voltar_menu()
        wait(10)


