class VoltarMenu(Exception):
    pass

def iniciar_cronometro_round():
    global round_iniciado, round_esgotado
    if not round_iniciado:
        cronometro_round.reset()
        round_iniciado = True
        round_esgotado = False
        print("ROUND FLL iniciado: 2:30")

def tempo_round_restante():
    if not round_iniciado:
        return TEMPO_ROUND_MS
    return max(0, TEMPO_ROUND_MS - cronometro_round.time())

def marcar_round_esgotado():
    global round_esgotado
    if not round_esgotado:
        round_esgotado = True
        parar_todos_motores()

        # Toca a musica uma unica vez, quando o round chega a 0:00.
        for nota, tempo in musica:
            tocar(nota, tempo)

def avisar_tempo_round():
    global aviso_2min, aviso_1min30, aviso_1min, aviso_30s

    if not round_iniciado or round_esgotado:
        return

    tempo_decorrido = cronometro_round.time()

    # Os avisos são disparados pelo tempo decorrido desde o início da R1.
    if tempo_decorrido >= 30000 and not aviso_2min:
        print("LOG: Faltam 2 minutos!")
        aviso_2min = True

    if tempo_decorrido >= 60000 and not aviso_1min30:
        print("LOG: Falta 1 minuto e 30 segundos!")
        aviso_1min30 = True

    if tempo_decorrido >= 90000 and not aviso_1min:
        print("LOG: Falta 1 minuto!")
        aviso_1min = True

    if tempo_decorrido >= 120000 and not aviso_30s:
        print("LOG: Faltam 30 segundos!")
        aviso_30s = True


def verificar_tempo_round():
    global round_esgotado
    if round_iniciado and not round_esgotado:
        avisar_tempo_round()
        if cronometro_round.time() >= TEMPO_ROUND_MS:
            marcar_round_esgotado()
            print("TEMPO DO ROUND ESGOTADO")
            raise VoltarMenu

def parar_todos_motores():
    motor_esq.stop()
    motor_dir.stop()
    motor_aux_esq.stop()
    motor_aux_dir.stop()

def esperar_soltar_botoes():
    while hub.buttons.pressed():
        wait(10)

def verificar_voltar_menu():
    # O tempo e compartilhado por todas as runs e continua no menu.
    verificar_tempo_round()

    if Button.CENTER in hub.buttons.pressed():
        parar_todos_motores()
        esperar_soltar_botoes()
        raise VoltarMenu

def run_angle_interrompivel(motor, velocidade, angulo):
    motor.run_angle(velocidade, angulo, then=Stop.HOLD, wait=False)

    while not motor.done():
        verificar_voltar_menu()
        wait(10)

def run_until_stalled_interrompivel(motor, velocidade):
    motor.run(velocidade)

    while not motor.stalled(): 
        verificar_voltar_menu()
        wait(10)

    motor.stop()

def atualizar_target_heading(novo_angulo):
    global target_heading
    target_heading = float(novo_angulo)

def erro_angular(alvo, atual):
    return (alvo - atual + 180) % 360 - 180

def limitar(valor, minimo, maximo):
    if valor < minimo:
        return minimo
    if valor > maximo:
        return maximo
    return valor

def mover(distancia_graus, velocidade_base, usar_sensores_parada=False):
    global target_heading

    # Zera os encoders antes de iniciar
    motor_esq.reset_angle(0)
    motor_dir.reset_angle(0)

    # Determina o sentido da movimentação
    distancia_alvo = abs(float(distancia_graus))
    sentido = -1 if distancia_graus < 0 else 1
    velocidade_maxima = abs(float(velocidade_base))

    if distancia_alvo == 0 or velocidade_maxima == 0:
        motor_esq.hold()
        motor_dir.hold()
        return

    # Perfil de aceleração e desaceleração
    ACELERACAO = 1200.0  # Graus/s²

    velocidade_minima = min(
        120.0,
        max(60.0, velocidade_maxima * 0.20)
    )

    # Inicialização do PID
    erro_filtrado = erro_angular(
        target_heading,
        hub.imu.heading()
    )

    erro_anterior = erro_filtrado
    integral = 0.0

    cronometro = StopWatch()
    cronometro_print = StopWatch()

    primeira_iteracao = True

    while True:

        verificar_voltar_menu()

        # 1. LEITURA DOS DOIS ENCODERS

        progresso_esq = motor_esq.angle() * sentido
        progresso_dir = motor_dir.angle() * sentido

        graus_atuais = max(
            0.0,
            (progresso_esq + progresso_dir) / 2.0
        )

        if graus_atuais >= distancia_alvo:
            break

        # 2. DISTÂNCIA RESTANTE

        distancia_restante = distancia_alvo - graus_atuais

        distancia_para_rampa = min(
            graus_atuais,
            distancia_restante
        )

        # 3. PERFIL DE VELOCIDADE

        velocidade_perfil = (
            velocidade_minima ** 2 +
            2.0 * ACELERACAO * distancia_para_rampa
        ) ** 0.5

        velocidade_magnitude = min(
            velocidade_maxima,
            velocidade_perfil
        )

        vel_alvo = sentido * velocidade_magnitude

        # 4. LEITURA DA IMU

        angulo_atual = hub.imu.heading()

        erro_bruto = erro_angular(
            target_heading,
            angulo_atual
        )

        # Filtro angular que evita problemas na passagem por +/-180 graus
        variacao_erro = erro_angular(
            erro_bruto,
            erro_filtrado
        )

        erro_filtrado = (
            erro_filtrado + 0.25 * variacao_erro + 180
        ) % 360 - 180

        # 5. CÁLCULO DO TEMPO REAL

        tempo_ms = cronometro.time()
        cronometro.reset()

        dt = max(0.001, tempo_ms / 1000.0)

        # 6. INTEGRAL

        if abs(erro_filtrado) < 8:

            integral += erro_filtrado * dt

            integral = limitar(
                integral,
                -40,
                40
            )

        else:
            integral = 0.0

        # 7. DERIVADA

        if primeira_iteracao:
            derivada = 0.0
            primeira_iteracao = False

        else:
            derivada = erro_angular(
                erro_filtrado,
                erro_anterior
            ) / dt

        erro_anterior = erro_filtrado

        # 8. CONTROLE PID

        correcao = (
            erro_filtrado * KP_LINE +
            integral * KI_LINE +
            derivada * KD_LINE
        )

        correcao = limitar(
            correcao,
            -velocidade_magnitude * 0.45,
            velocidade_magnitude * 0.45
        )

        # 9. COMANDO DOS MOTORES

        motor_esq.run(vel_alvo - correcao)
        motor_dir.run(vel_alvo + correcao)

        # 10. MONITORAMENTO A CADA 200 MS

        if cronometro_print.time() >= 200:

            diferenca_encoders = abs(
                progresso_esq - progresso_dir
            )

            cronometro_print.reset()

        if usar_sensores_parada:
            if (
                sensor_meio.reflection() < 18 or
                sensor_direita.reflection() < 18
            ):
                print(
                    "[SENSOR ALERTA]: Linha detectada. "
                    "Forçando parada."
                )
                break
        wait(10)

    motor_esq.hold()
    motor_dir.hold()

    wait(10)

    final_esq = motor_esq.angle() * sentido
    final_dir = motor_dir.angle() * sentido

    media_final = (final_esq + final_dir) / 2.0

    print(
        "[MOVER FINAL] Esquerdo: {:.1f} | "
        "Direito: {:.1f} | Média: {:.1f} | "
        "Diferença: {:.1f}".format(
            final_esq,
            final_dir,
            media_final,
            abs(final_esq - final_dir)
        )
    )

def girar(graus, velocidade_maxima):
    global target_heading
    atualizar_target_heading(graus)

    velocidade_maxima = abs(float(velocidade_maxima))
    if velocidade_maxima <= 0:
        motor_esq.brake()
        motor_dir.brake()
        return False

    tolerancia = 1.0
    velocidade_tolerancia = 20
    amostras_estaveis = 0
    derivada_filtrada = 0.0
    alpha = 0.35

    erro_inicial = erro_angular(
        target_heading,
        hub.imu.heading()
    )
    erro_anterior = erro_inicial
    primeira_iteracao = True

    velocidade_minima = min(
        velocidade_maxima,
        30,
        max(10, velocidade_maxima * 0.04)
    )
    tempo_limite = limitar(
        3000 + abs(erro_inicial) * 20 *
        (900 / max(velocidade_maxima, 150)),
        3000,
        15000
    )
    cronometro = StopWatch()
    cronometro_dt = StopWatch()
    while True:
        verificar_voltar_menu()
        angulo_atual = hub.imu.heading()

        erro = erro_angular(
            target_heading,
            angulo_atual
        )
        if abs(erro) <= tolerancia:

            motor_esq.brake()
            motor_dir.brake()

            velocidade_esq = abs(motor_esq.speed())
            velocidade_dir = abs(motor_dir.speed())

            if (
                velocidade_esq < velocidade_tolerancia
                and velocidade_dir < velocidade_tolerancia
            ):

                amostras_estaveis += 1
                if amostras_estaveis >= 3:
                    break
            else:
                amostras_estaveis = 0
            wait(10)
            continue
        else:
            amostras_estaveis = 0

        if cronometro.time() >= tempo_limite:
            motor_esq.brake()
            motor_dir.brake()

            print("[GIRO] Tempo limite excedido.")

            raise VoltarMenu

        tempo_ms = cronometro_dt.time()
        cronometro_dt.reset()
        dt = max(0.01, tempo_ms / 1000.0)

        if primeira_iteracao:
            derivada_bruta = 0.0
            primeira_iteracao = False
        else:
            diferenca_erro = erro_angular(
                erro,
                erro_anterior
            )
            derivada_bruta = diferenca_erro / dt
        erro_anterior = erro
        derivada_filtrada = (
            (1 - alpha) * derivada_filtrada
            + alpha * derivada_bruta
        )
        controle = (
            erro * KP_TURN
            + derivada_filtrada * KD_TURN
        )
        controle = limitar(
            controle,
            -velocidade_maxima,
            velocidade_maxima
        )

        if (
            abs(erro) > 2.0
            and controle * erro > 0
            and abs(controle) < velocidade_minima
        ):
            controle = (
                velocidade_minima
                if erro > 0
                else -velocidade_minima
            )
        motor_esq.run(-controle)
        motor_dir.run(controle)

        wait(10)

    motor_esq.brake()
    motor_dir.brake()
    wait(50)
    erro_final = erro_angular(
        target_heading,
        hub.imu.heading()
    )
    print(
        "[GIRO FINAL] Alvo: {} | Atual: {:.2f} | Erro: {:.2f}".format(
            target_heading,
            hub.imu.heading(),
            erro_final
        )
    )
    return abs(erro_final) <= 2.0

def girar_pivo(graus, velocidade_maxima, roda="dir"):
    # roda = a roda que se MOVE ("dir" ou "esq"). A outra fica travada como eixo do giro.
    atualizar_target_heading(graus)

    if roda == "dir":
        motor_movel = motor_dir
        motor_parado = motor_esq
        sentido = 1
    else:
        motor_movel = motor_esq
        motor_parado = motor_dir
        sentido = -1

    # Trava a roda que serve de pivô
    motor_parado.hold()

    angulo_inicial = hub.imu.heading()
    erro_anterior = erro_angular(target_heading, angulo_inicial)

    cronometro = StopWatch()

    while True:
        verificar_voltar_menu()

        angulo_atual = hub.imu.heading()
        erro = erro_angular(target_heading, angulo_atual)

        if abs(erro) < 1.0 and abs(motor_movel.speed()) < 20:
            break

        tempo = cronometro.time()
        cronometro.reset()

        dt = max(0.01, min(0.1, tempo / 1000))

        derivada = erro_angular(erro_anterior, erro) / dt
        erro_anterior = erro

        sinal_controle = (erro * KP_TURN) + (derivada * KD_TURN)

        # Limite máximo de velocidade
        sinal_controle = max(
            -velocidade_maxima,
            min(velocidade_maxima, sinal_controle)
        )

        # Velocidade mínima longe do alvo
        if abs(sinal_controle) < 22 and abs(erro) >= 2.0:
            sinal_controle = 22 if erro > 0 else -22

        motor_movel.run(sentido * sinal_controle)

        wait(10)

    motor_esq.brake()
    motor_dir.brake()

    print('Giro pivô concluído em {}°'.format(hub.imu.heading()))

