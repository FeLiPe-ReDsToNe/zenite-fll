def menu():
    indice = 0
    aviso_tempo_esgotado = False
    hub.speaker.beep(500, 50)
    hub.system.set_stop_button(None)
    mostrar_opcao(indice)
    esperar_soltar_botoes()

    while True:
        # Verifica o relogio mesmo quando o robô está parado no menu.
        if round_iniciado and not round_esgotado:
            avisar_tempo_round()
            if cronometro_round.time() >= TEMPO_ROUND_MS:
                marcar_round_esgotado()

        if round_esgotado and not aviso_tempo_esgotado:
            hub.speaker.beep(300, 300)
            hub.display.char("0")
            print("ROUND FLL encerrado. Tempo: 0:00")
            aviso_tempo_esgotado = True

        botoes = hub.buttons.pressed()

        if Button.LEFT in botoes:
            indice = (indice + 1) % len(OPCOES_MENU)
            mostrar_opcao(indice)
            esperar_soltar_botoes()

        elif Button.RIGHT in botoes:
            nome, rotina = OPCOES_MENU[indice]
            esperar_soltar_botoes()

            if round_esgotado:
                parar_todos_motores()
                print("Tempo do round esgotado. Nenhuma outra run pode iniciar.")
            else:
                # O cronometro começa uma unica vez, quando a R1 e iniciada.
                # Ao trocar para R2, R3... ou voltar ao menu, ele NÃO zera.
                if nome == "R1":
                    iniciar_cronometro_round()

                hub.display.char("P")
                hub.system.set_stop_button(None)
                print("Iniciando:", nome)
                try:
                    rotina()
                except VoltarMenu:
                    parar_todos_motores()
                    if round_esgotado:
                        print("Round encerrado. Voltando ao menu.")
                    else:
                        print("Rotina interrompida. Voltando ao menu.")

            if round_esgotado:
                hub.display.char("0")
            else:
                mostrar_opcao(indice)

        elif Button.CENTER in botoes:
            parar_todos_motores()
            hub.system.set_stop_button(None)
            hub.display.char("S")
            esperar_soltar_botoes()
            if round_esgotado:
                hub.display.char("0")
            else:
                mostrar_opcao(indice)

        wait(30)

menu()
