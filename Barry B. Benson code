OPCOES_MENU = (
    ("R1", R1),
    ("R2", R2),
    ("R3", R3),
    ("R4", R4),
    ("teste", teste),
)


def mostrar_opcao(indice):
    hub.display.number(indice + 1)
    print("Selecionado:", OPCOES_MENU[indice][0])


def menu():
    indice = 0
    hub.speaker.beep(500, 50)
    hub.system.set_stop_button(None)
    mostrar_opcao(indice)
    esperar_soltar_botoes()

    while True:
        botoes = hub.buttons.pressed()
        if Button.LEFT in botoes:
            indice = (indice + 1) % len(OPCOES_MENU)
            mostrar_opcao(indice)
            esperar_soltar_botoes()
        elif Button.RIGHT in botoes:
            nome, rotina = OPCOES_MENU[indice]
            esperar_soltar_botoes()
            hub.display.char("P")
            limpar_log()
            print("Iniciando:", nome)
            try:
                rotina()
                parar_todos_motores()
                hub.speaker.beep(700, 50)
                print("Rotina concluida:", nome)
            except VoltarMenu:
                parar_todos_motores()
                hub.speaker.beep(300, 80)
                print("Rotina interrompida. Voltando ao menu.")
            except BaseException:
                parar_todos_motores()
                hub.speaker.beep(200, 200)
                raise
            finally:
                mostrar_log()
                mostrar_opcao(indice)
        elif Button.CENTER in botoes:
            parar_todos_motores()
            hub.display.char("S")
            esperar_soltar_botoes()
            mostrar_opcao(indice)
        wait(30)


if __name__ == "__main__":
    menu()
